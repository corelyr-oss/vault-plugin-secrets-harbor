# Harbor configuration for integration tests. Rendered by up.sh; do not use in
# production. HTTP only, admin password fixed, no Trivy/Notary.
hostname: __HOSTNAME__
http:
  port: __PORT__
harbor_admin_password: Harbor12345
database:
  password: root123
  max_idle_conns: 100
  max_open_conns: 900
  conn_max_lifetime: 5m
  conn_max_idle_time: 0
data_volume: __DATA_DIR__
trivy:
  ignore_unfixed: false
  skip_update: true
  skip_java_db_update: true
  offline_scan: true
  security_check: vuln
  insecure: false
  timeout: 5m0s
jobservice:
  max_job_workers: 2
  job_loggers:
    - STDOUT
    - FILE
  logger_sweeper_duration: 1
notification:
  webhook_job_max_retry: 3
  webhook_job_http_client_timeout: 3
log:
  level: info
  local:
    rotate_count: 5
    rotate_size: 50M
    location: __LOG_DIR__
_version: 2.15.0
proxy:
  http_proxy:
  https_proxy:
  no_proxy:
  components:
    - core
    - jobservice
    - trivy
upload_purging:
  enabled: true
  age: 168h
  interval: 24h
  dryrun: false
cache:
  enabled: false
  expire_hours: 24
